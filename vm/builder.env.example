# /etc/devws-builder.env — read by the devws-builder service. Mode 600.
XCEED_URL=https://xceed.nitj.ac.in
# Same value as DEVWS_WORKER_SECRET in XCEED's server/.env
DEVWS_WORKER_SECRET=
# GitHub token that can create repos in the org, add collaborators, push
# branches and open PRs on the main repo
ORG_TOKEN=
# Optional: every preview gets a copy of this database (the shared TEST
# database, never production): the same MONGO_URL a local server/.env uses.
PREVIEW_SOURCE_MONGO_URL=
# Optional: comma-separated collections to leave out of the copy (big ones)
PREVIEW_SOURCE_EXCLUDE=
# How many jobs at once (each preview needs about 2 GB of memory)
DEVWS_PARALLEL=2
DEVWS_WORKDIR=/home/devws/work
